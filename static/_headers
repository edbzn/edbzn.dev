# Cloudflare Pages response headers (copied to public/_headers by Gatsby).
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Pages sends `Cache-Control: public, max-age=0, must-revalidate` by default,
# so browsers revalidate every asset on every visit. Files with a content hash
# in their name never change: cache them for a year. HTML and page-data keep
# the default, so a deploy is picked up on the next navigation.
#
# Rules that match the same path add up (values joined with a comma), so no
# path may match two rules that set Cache-Control.

# Webpack chunks and the stylesheet at the root: app-<hash>.js,
# component---<name>-<hash>.js, styles.<hash>.css...
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Hashed fonts, images and media emitted by webpack and gatsby-plugin-sharp.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted Fira Code: stable names, but the files never change.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Unhashed images (manifest icons, OG cards): cache a day, then refresh in
# the background.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Unhashed copies that /*.js and /*.css also match: back to the default.
/~partytown/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
